# Evertrust ERP — environment for the infra/docker-compose.yml stack.
#
# Copy to `.env` (which docker compose reads automatically) and adjust as needed:
#   cp .env.example .env
#
# These are LOCAL / M0 dev values. None are production secrets — rotate every
# secret-looking value before any deployed environment.

# --- Postgres (image env; creates the `evertrust` app DB + superuser) --------
POSTGRES_USER=evertrust
POSTGRES_PASSWORD=evertrust
POSTGRES_DB=evertrust

# --- API (NestJS) ------------------------------------------------------------
# DATABASE_URL is composed inside compose from POSTGRES_* (host=postgres), so it
# is not repeated here. The following map to apps/api Zod env contract:
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
# Browser origins allowed by CORS (comma-separated). The web app is on :3000.
CORS_ORIGINS=http://localhost:3000
# Pino log level (debug|info|warn|error). info is a sane default.
LOG_LEVEL=info

# --- Web (Next.js) -----------------------------------------------------------
# Inlined into the client bundle at BUILD time (Next public env). Points the
# browser at the API's host port mapping.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- n8n (queue mode: main + worker, separate `n8n` Postgres DB + Redis) -----
# Encryption key for n8n credentials at rest. Generate a real one for non-local.
N8N_ENCRYPTION_KEY=dev-encryption-key-change-me

# --- Growth Engine: ERP → n8n arsenal webhooks -------------------------------
# The ERP fires these n8n Cloud webhooks (outbound). Blank = that trigger is OFF.
# AIM / Lead Satellite / Ammo Forge already have Webhook triggers in n8n.
N8N_AIM_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/aim-deploy-campaign
N8N_LEAD_SATELLITE_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/wf03-lead-research
N8N_AMMO_FORGE_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/wf4-ammo-forge
# Reply Glock + Sleeper already have GET webhooks in n8n (the API fires GET to them).
N8N_REPLY_GLOCK_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/wf6-reply-glock
N8N_SLEEPER_GRENADE_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/wf8-sleeper-grenade
# Reach Bazooka has no webhook yet — add a GET Webhook at /webhook/wf2-reach-bazooka,
# then set this. Blank = its "Run now" reports "not wired up yet".
N8N_REACH_BAZOOKA_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/wf2-reach-bazooka
# (The daily Bazooka send time is an in-app setting, editable in the ERP UI.)

# --- Phase 5b: Claude price-assist -------------------------------------------
# Anthropic API key for line-item price suggestions. BLANK = the feature is
# disabled (the price-assist endpoint returns { configured: false }; the "Ask
# Claude" button shows a "not configured" notice instead of erroring).
ANTHROPIC_API_KEY=
# Model id used for suggestions. Override freely (e.g. a haiku/opus tier).
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# --- Phase 5c: Hermes supplier RFQ -------------------------------------------
# The n8n webhook the ERP fires to email an RFQ to selected suppliers. BLANK =
# the RFQ "send" is disabled (the API rejects it with a clear message). Add a
# POST Webhook in n8n at this path, then set the URL.
N8N_HERMES_RFQ_WEBHOOK_URL=https://evertrustgmbh.app.n8n.cloud/webhook/hermes-rfq-request
