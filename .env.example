# Evertrust ERP — environment for the infra/docker-compose.yml stack.
#
# Copy to `.env` (which docker compose reads automatically) and adjust as needed:
#   cp .env.example .env
#
# These are LOCAL / M0 dev values. None are production secrets — rotate every
# secret-looking value before any deployed environment.

# --- Postgres (image env; creates the `evertrust` app DB + superuser) --------
POSTGRES_USER=evertrust
POSTGRES_PASSWORD=evertrust
POSTGRES_DB=evertrust

# --- API (NestJS) ------------------------------------------------------------
# DATABASE_URL is composed inside compose from POSTGRES_* (host=postgres), so it
# is not repeated here. The following map to apps/api Zod env contract:
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d
# Browser origins allowed by CORS (comma-separated). The web app is on :3000.
CORS_ORIGINS=http://localhost:3000
# Pino log level (debug|info|warn|error). info is a sane default.
LOG_LEVEL=info

# --- Web (Next.js) -----------------------------------------------------------
# Inlined into the client bundle at BUILD time (Next public env). Points the
# browser at the API's host port mapping.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- n8n (queue mode: main + worker, separate `n8n` Postgres DB + Redis) -----
# Encryption key for n8n credentials at rest. Generate a real one for non-local.
N8N_ENCRYPTION_KEY=dev-encryption-key-change-me
